{
  "name": "dota2-translate-ptbr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:axe": "node scripts/sync-manifest.mjs --hero axe",
    "sync:catalog": "node scripts/sync-game-catalog.mjs && node scripts/export-web-seed.mjs && node scripts/sync-official-voice-catalog.mjs",
    "sync:official-voices": "node scripts/sync-official-voice-catalog.mjs",
    "audio:catalog": "node scripts/build-local-mp3-catalog.mjs",
    "audio:serve": "node scripts/serve-local-audio-catalog.mjs",
    "validate": "node scripts/validate.mjs",
    "web:seed": "node scripts/export-web-seed.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:test": "npm --prefix web test"
  },
  "engines": {
    "node": ">=20"
  }
}
