<Window x:Class="DublagemBrasileira.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dublagem Brasileira Dota 2"
        Width="1160"
        Height="820"
        MinWidth="860"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app-icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="32,18"
                Background="{StaticResource CanvasBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Viewbox Width="44" Height="44" Stretch="Uniform">
                    <Canvas Width="600" Height="600">
                        <Rectangle Width="600" Height="600" RadiusX="120" RadiusY="120"
                                   Fill="{StaticResource GreenBrush}"/>
                        <Path Fill="{StaticResource YellowBrush}"
                              Data="M95,145.5 149,115 510,421 474,507 361,481Z"/>
                        <Path Fill="{StaticResource YellowBrush}"
                              Data="M458.3,90.2 520,137 511.3,212.4 379.2,110.4Z"/>
                        <Path Fill="{StaticResource YellowBrush}"
                              Data="M84,466.6 100.7,373 228,482.8 131.6,506Z"/>
                    </Canvas>
                </Viewbox>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="17" FontWeight="Bold" Text="Dublagem Brasileira Dota 2"/>
                    <TextBlock Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Text="VOZES DA COMUNIDADE EM PT-BR"/>
                </StackPanel>

            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,30,32,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="0.85*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource Eyebrow}" Text="INSTALADOR WINDOWS"/>
                    <TextBlock Margin="0,10,0,0"
                               MaxWidth="690"
                               HorizontalAlignment="Left"
                               FontSize="38"
                               FontWeight="Medium"
                               LineHeight="42"
                               TextWrapping="Wrap">
                        <Run Text="Instale com segurança."/>
                        <LineBreak/>
                        <Run Foreground="{StaticResource GreenBrush}" Text="Restaure quando quiser."/>
                    </TextBlock>
                    <TextBlock Margin="0,14,0,26"
                               MaxWidth="650"
                               HorizontalAlignment="Left"
                               FontSize="14"
                               LineHeight="22"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Text="O instalador encontra o Dota em todas as bibliotecas Steam, valida os arquivos essenciais e cria backups antes de aplicar o teste local."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="INSTALAÇÃO DO DOTA 2"/>
                                    <TextBlock x:Name="DetectionTitle"
                                               Margin="0,8,0,0"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Text="Procurando nas bibliotecas Steam…"/>
                                </StackPanel>
                                <Button x:Name="RescanButton"
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource QuietButton}"
                                        Padding="13,8"
                                        Click="Rescan_Click"
                                        Content="Procurar novamente"/>
                            </Grid>

                            <Border Margin="0,18,0,0"
                                    Padding="15"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource GreenSoftBrush}"
                                            CornerRadius="17">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource GreenBrush}"
                                                   Text="✓"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0">
                                        <TextBlock x:Name="DotaPathText"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Text="Nenhum caminho selecionado"/>
                                        <TextBlock x:Name="DotaBuildText"
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Text="Aguardando validação"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="13,8"
                                            Click="Browse_Click"
                                            Content="Escolher pasta"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Width="32" Height="5"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource YellowBrush}"
                                        CornerRadius="3"/>
                                <TextBlock Margin="0,13,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="Vozes PT-BR"/>
                                <TextBlock x:Name="VoiceSummaryText"
                                           Margin="0,7,0,0"
                                           FontSize="13"
                                           LineHeight="19"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Text="Pack piloto do Axe com 243 falas verbais compiladas."/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Width="32" Height="5"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource BlueBrush}"
                                        CornerRadius="3"/>
                                <TextBlock Margin="0,13,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="Captions PT-BR"/>
                                <TextBlock x:Name="CaptionSummaryText"
                                           Margin="0,7,0,0"
                                           FontSize="13"
                                           LineHeight="19"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Text="Catálogo do projeto incorporado à camada brasileira para teste."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <Border Background="{StaticResource GreenBrush}"
                            CornerRadius="10"
                            Padding="23">
                        <StackPanel>
                            <TextBlock FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource YellowBrush}"
                                       Text="PRONTO PARA TESTAR"/>
                            <TextBlock Margin="0,10,0,0"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="Resumo de segurança"/>

                            <Grid Margin="0,20,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="DotaClosedDot" Width="9" Height="9"
                                         Margin="0,4,11,0" VerticalAlignment="Top"
                                         Fill="{StaticResource YellowBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Foreground="White" FontWeight="SemiBold" Text="Dota fechado"/>
                                    <TextBlock x:Name="DotaClosedText"
                                               Margin="0,2,0,0"
                                               Foreground="#CDE2D8"
                                               FontSize="11"
                                               Text="Verificando processo"/>
                                </StackPanel>

                                <Ellipse x:Name="InstallValidDot" Grid.Row="1" Width="9" Height="9"
                                         Margin="0,20,11,0" VerticalAlignment="Top"
                                         Fill="{StaticResource YellowBrush}"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,16,0,0">
                                    <TextBlock Foreground="White" FontWeight="SemiBold" Text="Instalação validada"/>
                                    <TextBlock x:Name="InstallValidText"
                                               Margin="0,2,0,0"
                                               Foreground="#CDE2D8"
                                               FontSize="11"
                                               Text="pak01_dir.vpk e boot.vcfg"/>
                                </StackPanel>

                                <Ellipse x:Name="BackupDot" Grid.Row="2" Width="9" Height="9"
                                         Margin="0,20,11,0" VerticalAlignment="Top"
                                         Fill="{StaticResource YellowBrush}"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,16,0,0">
                                    <TextBlock x:Name="BackupTitle"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               Text="Restauração disponível"/>
                                    <TextBlock x:Name="BackupText"
                                               Margin="0,2,0,0"
                                               Foreground="#CDE2D8"
                                               FontSize="11"
                                               Text="Backup criado antes de alterar"/>
                                </StackPanel>

                                <Ellipse Grid.Row="3" Width="9" Height="9"
                                         Margin="0,20,11,0" VerticalAlignment="Top"
                                         Fill="{StaticResource YellowBrush}"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,16,0,0">
                                    <TextBlock Foreground="White" FontWeight="SemiBold" Text="Sem injeção ou executáveis"/>
                                    <TextBlock Margin="0,2,0,0"
                                               Foreground="#CDE2D8"
                                               FontSize="11"
                                               Text="Apenas camada de idioma reversível"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="AÇÕES"/>

                            <Border Margin="0,14,0,0"
                                    Padding="12"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <RadioButton x:Name="CaptionsOnlyRadio"
                                             GroupName="InstallMode"
                                             IsChecked="True"
                                             VerticalContentAlignment="Center">
                                    <StackPanel Margin="7,0,0,0">
                                        <TextBlock FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="Somente legendas"/>
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Text="Catálogo PT-BR completo, sem substituir vozes."/>
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <Border Margin="0,8,0,0"
                                    Padding="12"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <RadioButton x:Name="CaptionsAndAxeRadio"
                                             GroupName="InstallMode"
                                             VerticalContentAlignment="Center">
                                    <StackPanel Margin="7,0,0,0">
                                        <TextBlock FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="Legendas + voz do Axe"/>
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Text="Inclui o pack-exemplo com 243 falas."/>
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Padding="12"
                                    Background="#FFF7D6"
                                    BorderBrush="#E6BE36"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <StackPanel>
                                    <TextBlock FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#765600"
                                               Text="PONTOS IMPORTANTES"/>
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="10"
                                               LineHeight="15"
                                               Foreground="#68551A"
                                               TextWrapping="Wrap"
                                               Text="O instalador segue a via de camada de idioma já utilizada pelo Dota para pacotes adicionais de linguagem. Registra dota_brazilian no caminho de captions e configura o idioma dentro dos arquivos do cliente. O gameinfo.gi recebe uma entrada reversível, com backup byte a byte, sem substituir o pacote inglês, mecânicas, executáveis ou DLLs. A Steam pode permanecer aberta e suas opções de inicialização não são alteradas. Como é uma iniciativa comunitária, uma atualização do jogo pode exigir o reparo da camada."/>
                                    <CheckBox x:Name="RiskAcknowledgement"
                                              Margin="0,9,0,0"
                                              FontSize="10"
                                              FontWeight="SemiBold"
                                              Foreground="#5A470F"
                                              Checked="RiskAcknowledgement_Changed"
                                              Unchecked="RiskAcknowledgement_Changed"
                                              Content="Li e compreendi estas informações."/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="InstallButton"
                                    Margin="0,14,0,0"
                                    Click="Install_Click"
                                    Content="Instalar / atualizar"/>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="RepairButton"
                                        Grid.Column="0"
                                        Margin="0,0,5,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="Repair_Click"
                                        Content="Reparar"/>
                                <Button x:Name="RestoreButton"
                                        Grid.Column="1"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource QuietButton}"
                                        Click="Restore_Click"
                                        Content="Restaurar"/>
                            </Grid>

                            <ProgressBar x:Name="OperationProgress"
                                         Margin="0,16,0,0"
                                         Height="5"
                                         IsIndeterminate="True"
                                         Minimum="0"
                                         Maximum="100"
                                         Visibility="Collapsed"
                                         Foreground="{StaticResource GreenBrush}"
                                         Background="{StaticResource GreenSoftBrush}"/>
                            <TextBlock x:Name="OperationStatus"
                                       Margin="0,10,0,0"
                                       FontSize="12"
                                       LineHeight="18"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="Nenhuma alteração será feita sem sua confirmação."/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <Expander Grid.Row="1"
                          Grid.ColumnSpan="2"
                          Margin="0,18,0,0"
                          Header="Detalhes técnicos"
                          Foreground="{StaticResource InkBrush}">
                    <Border Margin="0,8,0,0"
                            Padding="12"
                            MaxHeight="150"
                            Background="#102E2B"
                            CornerRadius="7">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogText"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10"
                                       LineHeight="16"
                                       Foreground="#D8E6DF"
                                       TextWrapping="Wrap"
                                       Text="Aguardando uma ação."/>
                        </ScrollViewer>
                    </Border>
                </Expander>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="32,20"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="TangoLeagueLogo"
                       Width="78"
                       Height="25"
                       VerticalAlignment="Center"
                       Source="/DublagemBrasileiraDota2;component/Assets/tangoleague-logo-text-black.png"
                       Stretch="Uniform"/>
                <TextBlock Grid.Column="1"
                           Margin="14,0"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Text="Projeto comunitário independente, sem vínculo, afiliação ou endosso da Valve."/>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Dota 2 e seus assets pertencem à Valve e/ou licenciantes."/>
            </Grid>
        </Border>
    </Grid>
</Window>
