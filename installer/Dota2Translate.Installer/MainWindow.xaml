<Window x:Class="Dota2TranslatePTBR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dota 2 Translate PT-BR" Height="650" Width="900"
        MinHeight="600" MinWidth="780" WindowStartupLocation="CenterScreen">
  <Grid Margin="36">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="DOTA 2 TRANSLATE PT-BR" Foreground="{StaticResource Gold}" FontSize="12" FontWeight="Bold" />
      <TextBlock Text="INSTALADOR DE VOZES" FontSize="42" FontWeight="Black" Margin="0,6,0,8" />
      <TextBlock Text="Instalação verificável, backup automático e restauração sem tocar em executáveis." Foreground="{StaticResource Muted}" FontSize="15" />
    </StackPanel>

    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="#3A332C" BorderThickness="1" Padding="18" Margin="0,26,0,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Instalação detectada" Foreground="{StaticResource Muted}" FontSize="11" />
          <TextBlock x:Name="DotaPathText" Text="Procurando Dota 2…" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Content="LOCALIZAR" Background="#2A2520" Click="Locate_Click" />
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" BorderBrush="#3A332C" BorderThickness="1" Padding="24">
        <StackPanel>
          <TextBlock Text="MODO SUPORTADO" Foreground="{StaticResource Gold}" FontSize="11" FontWeight="Bold" />
          <TextBlock Text="Addon oficial" FontSize="25" FontWeight="Bold" Margin="0,10" />
          <TextBlock Text="Instala em dota_addons e compila os recursos com os Workshop Tools locais. Funciona em Custom Game." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" />
          <Separator Margin="0,22" Background="#3A332C" />
          <TextBlock x:Name="PackageText" Text="Nenhum pacote selecionado." Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
          <Button Content="ESCOLHER PACOTE .ZIP" Background="#2A2520" Margin="0,18,0,0" HorizontalAlignment="Left" Click="ChoosePackage_Click" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="#673125" BorderThickness="1" Padding="24">
        <StackPanel>
          <TextBlock Text="LABORATÓRIO · BLOQUEADO" Foreground="{StaticResource Red}" FontSize="11" FontWeight="Bold" />
          <TextBlock Text="Cliente normal" FontSize="25" FontWeight="Bold" Margin="0,10" />
          <TextBlock Text="Só pode ser habilitado para builds testados, com montagem reversível. Nunca usa injeção, bypass de VAC/CRC ou alteração de executáveis." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" />
          <Separator Margin="0,22" Background="#3A332C" />
          <TextBlock x:Name="LabStatusText" Text="Nenhuma compatibilidade assinada para este build." Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
          <CheckBox x:Name="LabOptIn" Content="Entendo que este modo é experimental" IsEnabled="False" Margin="0,18,0,0" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="3" Margin="0,22,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="Pronto." Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="RESTAURAR" Background="#2A2520" Click="Restore_Click" />
        <Button x:Name="InstallButton" Content="INSTALAR ADDON" Click="Install_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
