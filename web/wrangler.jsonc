{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dublagem-brasileira-dota2",
	"account_id": "d498ec719fbf21aff0f0e165e46efe41",
	"main": "worker/index.ts",
	"compatibility_date": "2026-05-22",
	"workers_dev": true,
	"preview_urls": false,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"PUBLIC_SITE_URL": "https://dublagem.tangoleague.gg"
	},
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/audio/*"
		]
	},
	"routes": [
		{
			"pattern": "dublagem.tangoleague.gg",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dublagem-brasileira-prod",
			"database_id": "a669681c-cc94-4293-b1da-97366ebceb96",
			"remote": false,
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "dublagem-brasileira-media",
			"remote": false
		},
		{
			"binding": "SUBMISSIONS",
			"bucket_name": "dublagem-brasileira-submissions",
			"remote": false
		}
	]
}
